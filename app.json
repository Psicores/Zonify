{
  "expo": {
    "name": "Zonify",
    "slug": "zonify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zonify.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zonify.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Zonify usa tu ubicación para avisarte cuando llegas o sales de un lugar donde tienes tareas pendientes.",
          "locationAlwaysAndWhenInUsePermission": "Zonify necesita tu ubicación todo el tiempo para avisarte de tus tareas al llegar o salir de un lugar, incluso con la app cerrada. Tu ubicación se procesa en el teléfono y no se comparte.",
          "locationAlwaysPermission": false,
          "locationFullAccuracyPermission": false,
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      "expo-router",
      "@maplibre/maplibre-react-native",
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# Room crea las bases por reflexión (<Base>_Impl): WorkManager, que usan\n# expo-background-task y expo-task-manager, se cierra al arrancar si R8 las quita.\n-keep class * extends androidx.room.RoomDatabase { <init>(); }"
          }
        }
      ]
    ],
    "scheme": "zonify",
    "experiments": {
      "typedRoutes": true
    }
  }
}
